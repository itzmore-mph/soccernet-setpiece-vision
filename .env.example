# SoccerNet GSR credentials (required for download_soccernet.py only)
SOCCERNET_PASSWORD=your_soccernet_password_here

# Path to the external SSD containing SoccerNet GSR video data
# Required for: run_optimized_pipeline.py, run_tvcalib_batch.py, render_annotated_clips.py,
#               render_pc_overlay.py, dump_gt_setpieces.py
# Not required for: notebooks 02-04, analysis scripts (run from committed parquets)
SOCCERNET_LOCAL_DIR=/Volumes/YourDrive/soccernet-gsr

# Optional: override compute device (default: mps on Apple Silicon, cuda if available, else cpu)
# TORCH_DEVICE=cpu
